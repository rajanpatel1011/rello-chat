{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "Current File",
            "request": "launch",
            "mainClass": "${file}",
            "vmArgs": "-Dspring.profiles.active=local"
        },
        {
            "type": "java",
            "name": "Spring Boot-WebsocketDemoApplication<Rello>",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "mainClass": "com.rajan.WebsocketDemoApplication",
            "projectName": "Rello",
            "vmArgs": "-Dspring.profiles.active=local",
            "args": "--spring.profiles.active=local",
            "envFile": "${workspaceFolder}/.env"
        }
    ]
}